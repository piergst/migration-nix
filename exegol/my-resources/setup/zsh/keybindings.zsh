# -> destination: ~/.oh-my-zsh/custom/keybindings.zsh (auto-sourced by oh-my-zsh)

# zsh-autosuggestions
## Alt + l
bindkey '^[m' autosuggest-accept # Accepts the current suggestion.

# zsh-history-substring-search
bindkey '^[k' history-substring-search-up
bindkey '^[j' history-substring-search-down

bindkey "^[à" beginning-of-line
bindkey "^[$" end-of-line
bindkey "^[b" backward-word
bindkey "^[e" forward-word
bindkey "^[h" backward-char
bindkey "^[l" forward-char
bindkey "^[ " clear-screen
bindkey "^[n" backward-kill-line
bindkey "^[," kill-line
bindkey "^[i" delete-char
bindkey "^[u" backward-delete-char
